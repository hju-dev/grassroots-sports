# ─────────────────────────────────────────────
# Grass Roots Sports — environment variables
# Copy this file to .env.local for local dev,
# and add each value to Vercel → Project Settings → Environment Variables
# ─────────────────────────────────────────────

# ── Email (Resend) ────────────────────────────
# Create account at resend.com
# Verify your sending domain, then generate an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── PromptPay ─────────────────────────────────
# Alex's Thai phone number linked to PromptPay (digits only, no spaces)
# e.g. 0812345678
NEXT_PUBLIC_PROMPTPAY_NUMBER=0812345678

# ── Database (Neon) ───────────────────────────
# Create account at neon.tech, create a project, copy the connection string
# Then run src/lib/schema.sql in the Neon SQL editor
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Auth (Clerk) ──────────────────────────────
# Create account at clerk.com, create an application
# Copy keys from Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ── CMS (Sanity) ──────────────────────────────
# Create account at sanity.io, create a project
# Copy values from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
